PORT=
NODE_ENV=

# PostgreSQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=
# Secreto independiente para el panel de plataforma (super-admin). Distinto de JWT_SECRET.
PLATFORM_JWT_SECRET=

# Gemini AI
GEMINI_API_KEY=

# Clave AES-256 de 32 bytes en base64 para cifrar tokens de PSE. Generar con: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
PSE_ENCRYPTION_KEY=

# Background Jobs (RF-17)
JOBS_TOKEN=
JOB_NOT_PICKED_UP_MINUTES=
JOB_SUBSCRIPTIONS_MINUTES=

# Suscripciones y facturación manual (Tarea 13.2)
BILLING_GRACE_DAYS=5
PAYMENT_INSTRUCTIONS=

# Solo desarrollo. Nunca en producción
ENABLE_TEST_HOOKS=
