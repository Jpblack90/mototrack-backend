# Copiar como ~/mototrack/.env.prod en la VM y completar. NUNCA subir a git.
# Generar valores aleatorios en la VM con:  openssl rand -hex 32

# Dominio público. Con IP fija 34.176.10.20 → 34-176-10-20.sslip.io
DOMAIN=

POSTGRES_USER=mototrack_user
POSTGRES_DB=mototrack_db
POSTGRES_PASSWORD=          # NUEVA (openssl rand -hex 16)

JWT_SECRET=                 # NUEVO (openssl rand -hex 32). No reutilizar el de desarrollo.
PLATFORM_JWT_SECRET=        # NUEVO (openssl rand -hex 32). Distinto de JWT_SECRET.
JOBS_TOKEN=                 # NUEVO (openssl rand -hex 32)
PSE_ENCRYPTION_KEY=         # El MISMO del .env local (si cambia, los tokens PSE guardados no se pueden descifrar)
GEMINI_API_KEY=             # La misma clave de Gemini del .env local

DEMO_USERS_PASSWORD=        # Solo si se ejecuta seed:demo en una instalación limpia
BILLING_GRACE_DAYS=5
PAYMENT_INSTRUCTIONS=
